{
  "name": "homepage",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/build-without-warnings.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:once": "ng test --watch=false --browsers=ChromeHeadless",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run format:check && npm run lint && npm run build && npm run test:once"
  },
  "private": true,
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  },
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/material": "^21.2.14",
    "@angular/material-luxon-adapter": "^21.2.14",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "hammerjs": "^2.0.8",
    "luxon": "^3.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.26",
    "@eslint/js": "^10.0.1",
    "@types/hammerjs": "^2.0.45",
    "@types/jasmine": "~5.1.0",
    "@types/luxon": "^3.4.2",
    "angular-cli-ghpages": "^2.0.1",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.3.3",
    "random-test-values": "^2.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
